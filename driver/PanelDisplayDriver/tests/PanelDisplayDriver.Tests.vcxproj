    <ClInclude Include="..\common\PanelDisplayModes.h" />
    <ClInclude Include="..\common\PanelMonitorState.h" />
    <ClInclude Include="..\common\LatestFrameStore.h" />
    <ClInclude Include="..\common\PanelFrameDiagnostics.h" />
    <ClInclude Include="..\common\CaptureScheduler.h" />
    <ClInclude Include="..\driver\Public.h" />
