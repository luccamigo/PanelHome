<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android requires INTERNET for TCP sockets, including localhost through adb reverse. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked only when the user scans the pairing QR, never at startup. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 17 (targetSdk 37) requires this at runtime for sockets to a LAN address; asked only for WiFi. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Used only by the immediate-release compatibility wake fallback. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PanelHome">
        <meta-data
            android:name="com.panelos.panelhome.BUILD_IDENTITY"
            android:value="${panelBuildIdentity}" />
        <meta-data
            android:name="com.panelos.panelhome.BUILD_NUMBER"
            android:value="${panelBuildNumber}" />
        <meta-data
            android:name="com.panelos.panelhome.PROTOCOL_VERSION"
            android:value="${panelProtocolVersion}" />
        <service
            android:name=".session.PanelSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/usb_accessory_filter" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Pairing screen: camera QR scan or typed code. Private to the app; the secret on screen is never captured. -->
        <activity
            android:name=".ui.wifi.WifiPairActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <receiver
            android:name=".power.PanelDeviceAdminReceiver"
            android:description="@string/power_admin_description"
            android:exported="true"
            android:label="@string/power_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/panel_device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
