<UserControl x:Class="PanelOS.ControlCenter.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <!--
                        A filled chip reads as its own object in the header
                        strip; the default inline form reads as a line inside a
                        card. Same corner as the buttons and cards around it.
                    -->
                    <DataTrigger Binding="{Binding IsChip, ElementName=Root}" Value="True">
                        <Setter Property="Padding" Value="11,5" />
                        <Setter Property="Background"
                                Value="{Binding Level,
                                                ElementName=Root,
                                                Converter={StaticResource StatusLevelToAttentionBrush}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!--
                The mark is a shape before it is a colour: a check, a triangle,
                a cross or a dot. State survives being read by someone who
                cannot separate green from amber, and the text says it a second
                time regardless.
            -->
            <Path Data="{Binding Level,
                                 ElementName=Root,
                                 Converter={StaticResource StatusLevelToGeometry}}"
                  Fill="{Binding Level,
                                 ElementName=Root,
                                 Converter={StaticResource StatusLevelToBrush}}"
                  Style="{StaticResource PanelStatusMark}" />

            <TextBlock Text="{Binding Caption, ElementName=Root}"
                       Foreground="{StaticResource PanelTextMutedBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,7,0"
                       Visibility="{Binding Caption,
                                            ElementName=Root,
                                            Converter={StaticResource TextToVisibility}}" />

            <TextBlock Text="{Binding Text, ElementName=Root}"
                       Foreground="{StaticResource PanelTextBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</UserControl>
