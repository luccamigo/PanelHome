<UserControl x:Class="PanelOS.ControlCenter.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PanelOS.ControlCenter.Controls"
             xmlns:res="clr-namespace:PanelOS.ControlCenter.Resources">
    <!--
        One segment at a time. Fourteen facts and a log window competing on one
        scrolling page is a dump; the same facts behind Resumo, Host,
        Transporte, Display, Vídeo and Logs is a diagnosis.

        Nothing here is estimated: a value the driver or the agent did not
        report is shown as absent, and nothing on any other screen depends on
        parsing these lines.
    -->
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Currency synchronisation is off: rebuilding the groups on every
                refresh would otherwise leave the last one added - the log -
                selected, whatever the operator was reading.
            -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource PanelSegmentedItem}"
                     IsSynchronizedWithCurrentItem="False"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Column="1"
                    Content="{res:Loc ActionRefresh}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource PanelButton}"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- ================= Rows ================= -->
        <Grid>
            <ScrollViewer Style="{StaticResource PanelScrollViewer}"
                          Padding="0,0,10,0"
                          Visibility="{Binding IsLogsSelected,
                                               Converter={StaticResource InverseBooleanToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{res:Loc DiagnosticsSummaryCaption}"
                               Style="{StaticResource PanelMutedText}"
                               Margin="0,0,0,12"
                               Visibility="{Binding SelectedGroup.IsSummary,
                                                    Converter={StaticResource BooleanToVisibility}}" />

                    <Border Style="{StaticResource PanelCard}">
                        <Grid>
                            <TextBlock Text="{res:Loc DiagnosticsEmptyGroup}"
                                       Style="{StaticResource PanelMutedText}"
                                       Visibility="{Binding SelectedGroup.Rows.Count,
                                                            Converter={StaticResource EmptyCountToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding SelectedGroup.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   Style="{StaticResource PanelMutedText}"
                                                   VerticalAlignment="Top"
                                                   Margin="0,0,14,0" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{Binding Level,
                                                                     Converter={StaticResource StatusLevelToGeometry}}"
                                                      Fill="{Binding Level,
                                                                     Converter={StaticResource StatusLevelToBrush}}"
                                                      Style="{StaticResource PanelStatusMark}"
                                                      VerticalAlignment="Top"
                                                      Margin="0,3,8,0" />
                                                <TextBlock Text="{Binding Value}"
                                                           Style="{StaticResource PanelValueText}" />
                                            </StackPanel>

                                            <!-- What to do about it, when there is something. -->
                                            <TextBlock Text="{Binding Hint}"
                                                       Style="{StaticResource PanelCaptionText}"
                                                       Margin="19,4,0,0"
                                                       Visibility="{Binding HasHint,
                                                                            Converter={StaticResource BooleanToVisibility}}" />

                                            <!-- The raw form, present and closed. -->
                                            <Expander Style="{StaticResource PanelDisclosure}"
                                                      Header="{res:Loc ActionDetails}"
                                                      Margin="15,6,0,0"
                                                      Visibility="{Binding HasTechnical,
                                                                           Converter={StaticResource BooleanToVisibility}}">
                                                <TextBlock Text="{Binding Technical}"
                                                           Style="{StaticResource PanelMonoText}"
                                                           TextWrapping="Wrap" />
                                            </Expander>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="{res:Loc ActionCopy}"
                                                Command="{Binding DataContext.CopyRowCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PanelGhostButton}"
                                                VerticalAlignment="Top"
                                                Margin="12,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- ================= Video metrics ================= -->
                    <StackPanel Visibility="{Binding SelectedGroup.IsVideo,
                                                     Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="{res:Loc DiagnosticsMetricsTitle}"
                                   Style="{StaticResource PanelSectionTitleText}"
                                   Margin="{StaticResource GapPageSection}" />
                        <TextBlock Text="{res:Loc DiagnosticsMetricsCaption}"
                                   Style="{StaticResource PanelMutedText}"
                                   Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding RuntimeMetrics}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelCard}"
                                            Padding="{StaticResource CardPaddingTight}"
                                            Margin="{StaticResource CardGutter}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       Style="{StaticResource PanelCardLabelText}" />
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{Binding Level,
                                                                     Converter={StaticResource StatusLevelToGeometry}}"
                                                      Fill="{Binding Level,
                                                                     Converter={StaticResource StatusLevelToBrush}}"
                                                      Style="{StaticResource PanelStatusMark}" />
                                                <TextBlock Text="{Binding Value}"
                                                           Style="{StaticResource PanelMetricText}"
                                                           FontSize="19" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}"
                                                       Style="{StaticResource PanelCaptionText}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= Logs ================= -->
            <!--
                The log lives in its own segment so it cannot dominate the page,
                and it fills that segment so a long line is actually readable.
            -->
            <HeaderedContentControl Style="{StaticResource PanelSectionCard}"
                                    Header="{res:Loc DiagnosticsLogsTitle}"
                                    controls:PanelUi.Caption="{res:Loc DiagnosticsLogsCaption}"
                                    controls:PanelUi.IconKey="IconLogs"
                                    Visibility="{Binding IsLogsSelected,
                                                         Converter={StaticResource BooleanToVisibility}}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{res:Loc DiagnosticsLogFilterLabel}"
                                       Style="{StaticResource PanelCardLabelText}"
                                       Margin="0,0,0,5" />
                            <TextBox Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{res:Loc DiagnosticsLogFilterHint}"
                                     AutomationProperties.Name="{res:Loc DiagnosticsLogFilterHint}"
                                     MinWidth="180" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{res:Loc DiagnosticsLogStreamLabel}"
                                       Style="{StaticResource PanelCardLabelText}"
                                       Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding LogStreamFilters}"
                                      SelectedItem="{Binding SelectedLogStream, Mode=TwoWay}"
                                      IsSynchronizedWithCurrentItem="False"
                                      AutomationProperties.Name="{res:Loc DiagnosticsLogStreamLabel}"
                                      MinWidth="170">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding LogCountText}"
                                   Style="{StaticResource PanelMutedText}"
                                   VerticalAlignment="Bottom"
                                   Margin="12,0,0,9" />
                    </Grid>

                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{res:Loc ActionCopy}"
                                    Command="{Binding CopyLogCommand}"
                                    Style="{StaticResource PanelButton}"
                                    Margin="0,0,8,0" />
                            <Button Content="{res:Loc DiagnosticsLogClear}"
                                    Command="{Binding ClearLogViewCommand}"
                                    Style="{StaticResource PanelButton}" />
                        </StackPanel>
                        <CheckBox Content="{res:Loc DiagnosticsLogAutoScroll}"
                                  IsChecked="{Binding AutoScrollLog, Mode=TwoWay}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="{res:Loc DiagnosticsLogExternalNote}"
                                   Style="{StaticResource PanelCaptionText}" />
                        <controls:FactRow Label="{res:Loc DiagnosticsLogDirectoryLabel}"
                                          Value="{Binding LogDirectory}"
                                          LabelWidth="120"
                                          IsMono="True" />
                    </StackPanel>

                    <Border Style="{StaticResource PanelWell}" MinHeight="200">
                        <Grid>
                            <!-- Two different empty states: nothing yet, or nothing matching. -->
                            <TextBlock Text="{res:Loc DiagnosticsLogEmpty}"
                                       Style="{StaticResource PanelMutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasLogEntries,
                                                            Converter={StaticResource InverseBooleanToVisibility}}" />
                            <TextBlock Text="{res:Loc DiagnosticsLogNoMatch}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock"
                                           BasedOn="{StaticResource PanelMutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasLogEntries}"
                                                               Value="True" />
                                                    <Condition Binding="{Binding HasVisibleLogEntries}"
                                                               Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox x:Name="LogList"
                                     ItemsSource="{Binding VisibleLogEntries}"
                                     ItemContainerStyle="{StaticResource PanelLogItem}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}"
                                                   Style="{StaticResource PanelMonoText}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </DockPanel>
            </HeaderedContentControl>
        </Grid>
    </DockPanel>
</UserControl>
