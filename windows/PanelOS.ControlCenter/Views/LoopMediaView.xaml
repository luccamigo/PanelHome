<UserControl x:Class="PanelOS.ControlCenter.Views.LoopMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PanelOS.ControlCenter.Controls"
             xmlns:res="clr-namespace:PanelOS.ControlCenter.Resources">
    <ScrollViewer Style="{StaticResource PanelScrollViewer}" Padding="0,0,10,0">
        <HeaderedContentControl Style="{StaticResource PanelSectionCard}"
                                Header="{res:Loc LoopMediaCurrent}"
                                controls:PanelUi.Caption="{res:Loc LoopMediaHint}"
                                controls:PanelUi.IconKey="IconVideo"
                                MaxWidth="820" HorizontalAlignment="Left"
                                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding FileName}" Style="{StaticResource PanelMutedText}"
                           TextWrapping="Wrap" AutomationProperties.AutomationId="LoopMediaFileName" />
                <TextBlock Text="{Binding Details}" Style="{StaticResource PanelCaptionText}"
                           Margin="0,6,0,18" />
                <WrapPanel>
                    <Button Content="{res:Loc LoopMediaChoose}" Command="{Binding ChooseCommand}"
                            Style="{StaticResource PanelPrimaryButton}" Margin="0,0,10,8"
                            AutomationProperties.AutomationId="LoopMediaChoose" />
                    <Button Content="{res:Loc LoopMediaRemove}" Command="{Binding RemoveCommand}"
                            Style="{StaticResource PanelDangerButton}" Margin="0,0,0,8"
                            AutomationProperties.AutomationId="LoopMediaRemove" />
                </WrapPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource PanelMutedText}"
                           Foreground="{StaticResource PanelStatusWarningBrush}" Margin="0,10,0,0"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.AutomationId="LoopMediaError"
                           Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </HeaderedContentControl>
    </ScrollViewer>
</UserControl>
