<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Icons are drawn as geometry rather than taken from an icon font or a
        package: the set is small, this cannot render as a missing-glyph box on
        any machine, and it matches the panel, which draws its own button
        glyphs. Every path is authored on a 0..20 box and stretched uniformly.

        Navigation icons are stroked; status icons are filled, because a status
        mark has to stay legible at 10 px.
    -->

    <!-- ==================== Navigation ==================== -->
    <Geometry x:Key="IconOverview">
        M2,2 H9 V9 H2 Z M11,2 H18 V6 H11 Z M11,8 H18 V18 H11 Z M2,11 H9 V18 H2 Z
    </Geometry>

    <!-- A tablet on a stand: the device this whole page is about. -->
    <Geometry x:Key="IconDevice">
        M3,2 H17 V13 H3 Z M8,13 V16 M12,13 V16 M6,16 H14
    </Geometry>

    <Geometry x:Key="IconStreamDeck">
        M2,2 H7 V7 H2 Z M9,2 H14 V7 H9 Z M16,2 H18 V7 H16 Z
        M2,9 H7 V14 H2 Z M9,9 H14 V14 H9 Z M16,9 H18 V14 H16 Z
    </Geometry>

    <Geometry x:Key="IconDiagnostics">
        M1,10 H5 L7,4 L10,16 L13,8 L15,10 H19
    </Geometry>
    <Geometry x:Key="IconIntegrations">
        M6,2 V6 M14,2 V6 M4,6 H16 V10 Q16,15 10,15 Q4,15 4,10 Z M10,15 V19
    </Geometry>

    <Geometry x:Key="IconSettings">
        M2,5 H7 M11,5 H18 M2,10 H13 M17,10 H18 M2,15 H5 M9,15 H18
    </Geometry>

    <!-- Kept so a stored icon key from an older build still resolves. -->
    <Geometry x:Key="IconWifi">
        M2,8 Q10,1 18,8 M5,11 Q10,6.5 15,11 M8,14 Q10,12.2 12,14 M10,17 V17.1
    </Geometry>
    <Geometry x:Key="IconDashboard">
        M2,2 H9 V9 H2 Z M11,2 H18 V6 H11 Z M11,8 H18 V18 H11 Z M2,11 H9 V18 H2 Z
    </Geometry>

    <!-- ==================== Component marks ==================== -->
    <Geometry x:Key="IconHost">
        M2,4 H18 V9 H2 Z M2,11 H18 V16 H2 Z M5,6.5 H5.01 M5,13.5 H5.01
    </Geometry>

    <Geometry x:Key="IconDisplay">
        M2,3 H18 V14 H2 Z M7,17 H13 M10,14 V17
    </Geometry>

    <Geometry x:Key="IconVideo">
        M2,5 H12 V15 H2 Z M12,9 L18,5.5 V14.5 L12,11 Z
    </Geometry>

    <Geometry x:Key="IconLogs">
        M4,2 H13 L16,5 V18 H4 Z M12,2 V6 H16 M7,10 H13 M7,13 H13
    </Geometry>

    <!-- ==================== Status marks ==================== -->
    <!--
        A different shape per level, so state never depends on colour alone:
        a check for good, a bar-and-dot for warning, a cross for bad, a dot for
        "nothing measured yet".
    -->
    <Geometry x:Key="IconStatusGood">
        M10,0 A10,10 0 1,0 10,20 A10,10 0 1,0 10,0 Z
        M8.9,14.4 L4.8,10.3 L6.3,8.8 L8.9,11.4 L13.7,6.6 L15.2,8.1 Z
    </Geometry>

    <Geometry x:Key="IconStatusWarning">
        M10,0.6 L19.8,18.4 L0.2,18.4 Z
        M9,6.6 H11 V12 H9 Z
        M9,13.6 H11 V15.6 H9 Z
    </Geometry>

    <Geometry x:Key="IconStatusBad">
        M10,0 A10,10 0 1,0 10,20 A10,10 0 1,0 10,0 Z
        M6.5,8 L8,6.5 L10,8.5 L12,6.5 L13.5,8 L11.5,10 L13.5,12 L12,13.5
        L10,11.5 L8,13.5 L6.5,12 L8.5,10 Z
    </Geometry>

    <Geometry x:Key="IconStatusNeutral">
        M10,4 A6,6 0 1,0 10,16 A6,6 0 1,0 10,4 Z
    </Geometry>

</ResourceDictionary>
