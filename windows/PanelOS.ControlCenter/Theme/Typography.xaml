<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        A short type scale with one role per style. Anything that seems to need
        a size not on this list is usually a layout problem wearing a font size.

        Hierarchy is carried by size *and* colour: a page title is large and
        bright, a caption is small and muted, and nothing in between borrows a
        weight to look important.
    -->

    <!-- Page title, once per screen. -->
    <Style x:Key="PanelPageTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="PanelPageDescriptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- Heading above a group of cards. -->
    <Style x:Key="PanelSectionTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Title inside a card. -->
    <Style x:Key="PanelCardTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Small uppercase eyebrow: the category a card belongs to. -->
    <Style x:Key="PanelCardLabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="PanelBodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PanelMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Third level: a unit, a path, a hint under a field. -->
    <Style x:Key="PanelCaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextFaintBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The one number a tile is about. -->
    <Style x:Key="PanelMetricText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A measured value beside its label, smaller than a headline metric. -->
    <Style x:Key="PanelValueText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PanelMonoText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Field label inside a form. -->
    <Style x:Key="PanelFieldLabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,12,0,5" />
    </Style>

    <!-- Kept so views written against the previous scale still resolve. -->
    <Style x:Key="PanelTitleText"
           TargetType="TextBlock"
           BasedOn="{StaticResource PanelPageTitleText}" />
    <Style x:Key="PanelSectionText"
           TargetType="TextBlock"
           BasedOn="{StaticResource PanelSectionTitleText}" />
    <Style x:Key="PanelGroupHeaderText"
           TargetType="TextBlock"
           BasedOn="{StaticResource PanelSectionTitleText}" />

</ResourceDictionary>
