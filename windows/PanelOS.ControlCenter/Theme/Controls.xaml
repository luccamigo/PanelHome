<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:PanelOS.ControlCenter.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
        <ResourceDictionary Source="Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        The component vocabulary: surfaces, buttons, navigation, inputs and the
        few composite pieces the pages repeat. A view assembles these; it never
        invents a background, a border or a hover colour of its own.
    -->

    <!-- ==================================================================== -->
    <!-- Surfaces                                                             -->
    <!-- ==================================================================== -->

    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelOutlineSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A card the eye should land on first. -->
    <Style x:Key="PanelCardRaised"
           TargetType="Border"
           BasedOn="{StaticResource PanelCard}">
        <Setter Property="Background" Value="{StaticResource PanelSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelOutlineBrush}" />
    </Style>

    <!-- Recessed area: log output, the tablet preview, a read-only value. -->
    <Style x:Key="PanelWell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelSurfaceSunkenBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelOutlineSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PanelTabletFrame"
           TargetType="Border"
           BasedOn="{StaticResource PanelWell}">
        <Setter Property="BorderBrush" Value="{StaticResource PanelOutlineBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- A one-pixel rule between rows of a list; quieter than a Separator. -->
    <Style x:Key="PanelDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource PanelOutlineSubtleBrush}" />
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <!-- ==================================================================== -->
    <!-- Section card: title, optional caption and icon, then its content      -->
    <!-- ==================================================================== -->
    <!--
        Every page is built from these, which is what keeps the headings, the
        spacing and the rhythm identical across five screens. Set Header for the
        title, PanelUi.Caption for the line under it, PanelUi.IconKey for the
        mark beside it.
    -->
    <Style x:Key="PanelSectionCard" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{StaticResource PanelSurfaceBrush}"
                            BorderBrush="{StaticResource PanelOutlineSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLg}"
                            Padding="{StaticResource CardPadding}"
                            SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Path x:Name="Icon"
                                      Grid.Column="0"
                                      Data="{Binding (controls:PanelUi.IconKey),
                                                     RelativeSource={RelativeSource TemplatedParent},
                                                     Converter={StaticResource ResourceKeyToGeometry}}"
                                      Stroke="{StaticResource PanelTextFaintBrush}"
                                      Fill="Transparent"
                                      StrokeThickness="1.4"
                                      StrokeLineJoin="Round"
                                      Width="17"
                                      Height="17"
                                      Stretch="Uniform"
                                      VerticalAlignment="Top"
                                      Margin="0,2,10,0" />

                                <StackPanel Grid.Column="1">
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.Foreground="{StaticResource PanelTextBrush}"
                                                      TextBlock.FontSize="14"
                                                      TextBlock.FontWeight="SemiBold" />
                                    <TextBlock x:Name="Caption"
                                               Text="{Binding (controls:PanelUi.Caption),
                                                              RelativeSource={RelativeSource TemplatedParent}}"
                                               Style="{StaticResource PanelCaptionText}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Caption" Property="Text" Value="">
                            <Setter TargetName="Caption"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="Icon" Property="Data" Value="{x:Null}">
                            <Setter TargetName="Icon"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!-- Status                                                               -->
    <!-- ==================================================================== -->

    <!--
        The status mark: a shape that differs per level, so state survives being
        printed in grey or read by someone who cannot separate the colours.
    -->
    <Style x:Key="PanelStatusMark" TargetType="Path">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- StatusBadge carries its own layout; see Controls/StatusBadge.xaml. -->
    <Style TargetType="{x:Type controls:StatusBadge}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- ==================================================================== -->
    <!-- Buttons                                                              -->
    <!-- ==================================================================== -->
    <!--
        Four weights, and they mean different things: secondary is the default,
        primary marks the one action a screen is for, danger marks the one that
        stops or destroys something, ghost is for an action that sits inside
        another control's chrome. Making everything primary would say nothing.
    -->

    <Style x:Key="PanelButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelOutlineBrush}" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <!-- Focus must stay visible; it is how the keyboard works. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelPrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource PanelButton}">
        <Setter Property="Background" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PanelOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Stop, delete, disconnect: reads as consequential without shouting. -->
    <Style x:Key="PanelDangerButton"
           TargetType="Button"
           BasedOn="{StaticResource PanelButton}">
        <Setter Property="Foreground" Value="{StaticResource PanelStatusBadBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelStatusBadSoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelDangerOutlineBrush}" />
    </Style>

    <!-- Compact action inside a toolbar strip. -->
    <Style x:Key="PanelToolbarButton"
           TargetType="Button"
           BasedOn="{StaticResource PanelButton}">
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelOutlineSubtleBrush}" />
    </Style>

    <!-- Same size as a toolbar button, in the danger weight. -->
    <Style x:Key="PanelToolbarDangerButton"
           TargetType="Button"
           BasedOn="{StaticResource PanelToolbarButton}">
        <Setter Property="Foreground" Value="{StaticResource PanelStatusBadBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelDangerOutlineBrush}" />
    </Style>

    <!-- No chrome until it is pointed at: a link-weight action. -->
    <Style x:Key="PanelGhostButton"
           TargetType="Button"
           BasedOn="{StaticResource PanelButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <!-- Quiet until pointed at: a column of these must not read as a list. -->
        <Setter Property="Foreground" Value="{StaticResource PanelTextFaintBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="28" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource PanelAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A square action carrying only a glyph; always needs a ToolTip. -->
    <Style x:Key="PanelIconButton"
           TargetType="Button"
           BasedOn="{StaticResource PanelToolbarButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ==================================================================== -->
    <!-- Navigation                                                           -->
    <!-- ==================================================================== -->

    <Style x:Key="PanelSidebarItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,1">
                        <!-- Selection is marked by a rail, not only by fill. -->
                        <Border x:Name="Rail"
                                Width="3"
                                HorizontalAlignment="Left"
                                Margin="0,7"
                                CornerRadius="{StaticResource RadiusXs}"
                                Background="Transparent" />
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="13,9"
                                Margin="11,0,0,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource PanelTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceBrush}" />
                            <Setter TargetName="Rail"
                                    Property="Background"
                                    Value="{StaticResource PanelAccentMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceElevatedBrush}" />
                            <Setter TargetName="Rail"
                                    Property="Background"
                                    Value="{StaticResource PanelAccentBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource PanelTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Segmented control: switches which part of one page is on screen, so it
        looks like a switch and not like five links.
    -->
    <Style x:Key="PanelSegmentedItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="14,7"
                            Margin="0,0,4,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground"
                                    Value="{StaticResource PanelTextBrush}" />
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceElevatedBrush}" />
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelOutlineBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource PanelTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Page tabs above the Stream Deck grid. -->
    <Style x:Key="PanelPageTab" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="13,6"
                            Margin="0,0,6,6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelOutlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceElevatedBrush}" />
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource PanelTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Profile entries in the editor's left column. -->
    <Style x:Key="PanelListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="10,8"
                            Margin="0,1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceElevatedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceElevatedBrush}" />
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource PanelTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A log line: no selection chrome, just a row that can be read. -->
    <Style x:Key="PanelLogItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceElevatedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!-- Stream Deck grid cell                                                -->
    <!-- ==================================================================== -->

    <Style x:Key="PanelDeckCell" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{StaticResource PanelSurfaceBrush}"
                            BorderBrush="{StaticResource PanelOutlineSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            MinHeight="82"
                            Padding="8">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelOutlineBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentMutedBrush}" />
                        </Trigger>
                        <!-- The selected button drives the whole right column. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceElevatedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!-- Scrolling                                                            -->
    <!-- ==================================================================== -->
    <!--
        A thin, quiet scrollbar. The default Windows one is a light grey block
        that becomes the brightest thing on a dark page.
    -->

    <Style x:Key="PanelScrollBarThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Root"
                            Background="{StaticResource PanelOutlineBrush}"
                            CornerRadius="{StaticResource RadiusXs}"
                            Margin="3,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelTextFaintBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PanelScrollBarThumb}" />
                            </Track.Thumb>
                            <!--
                                No arrow buttons: they are two more click targets
                                for something the wheel already does.
                            -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Opacity="0"
                                              Focusable="False"
                                              IsTabStop="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Opacity="0"
                                              Focusable="False"
                                              IsTabStop="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10" />
                            <Setter Property="MinHeight" Value="10" />
                            <Setter TargetName="PART_Track"
                                    Property="IsDirectionReversed"
                                    Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- ==================================================================== -->
    <!-- Inputs                                                               -->
    <!-- ==================================================================== -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource PanelSurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelOutlineBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only value that should still be selectable for copying. -->
    <Style x:Key="PanelReadOnlyTextBox" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="CaretBrush" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource PanelAccentBrush}" />
        <Setter Property="Cursor" Value="IBeam" />
    </Style>

    <!--
        The combo box is templated rather than themed by setters. The Windows
        default paints its own light chrome and its own text colour, which is
        the one control that would still look like a different application
        after every other surface had been restyled.

        The closed box renders SelectionBoxItemTemplate, so a combo over
        objects must set ItemTemplate; DisplayMemberPath alone leaves the
        selection showing ToString().
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="Background" Value="{StaticResource PanelSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelOutlineBrush}" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen,
                                                          RelativeSource={RelativeSource TemplatedParent},
                                                          Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="{Binding Background,
                                                                 RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush,
                                                                  RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            SnapsToDevicePixels="True">
                                        <Path x:Name="Chevron"
                                              Data="M0,0 L4,4 L8,0"
                                              Stroke="{StaticResource PanelTextFaintBrush}"
                                              StrokeThickness="1.4"
                                              StrokeLineJoin="Round"
                                              Width="9"
                                              Height="6"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,11,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource PanelAccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource PanelAccentBrush}" />
                                            <Setter TargetName="Chevron"
                                                    Property="Stroke"
                                                    Value="{StaticResource PanelAccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!--
                            The selection box sits outside the toggle button so
                            it inherits the combo's own foreground instead of
                            the button chrome's.
                        -->
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}" />

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               VerticalOffset="4"
                               Focusable="False"
                               PopupAnimation="None"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource PanelSurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource PanelOutlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Padding="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Style="{StaticResource PanelScrollViewer}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource PanelAccentSoftBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A switch, not a tick box: the label states what turns on and the
        description under it states the consequence, which is where "stop
        PanelHost on exit" stops being ambiguous.
    -->
    <Style x:Key="PanelSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ContentPresenter VerticalAlignment="Center" />
                            <TextBlock x:Name="Description"
                                       Text="{Binding (controls:PanelUi.Description),
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource PanelTextMutedBrush}"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Border x:Name="Track"
                                Grid.Column="1"
                                Width="38"
                                Height="22"
                                VerticalAlignment="Top"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="{StaticResource PanelSurfaceElevatedBrush}"
                                BorderBrush="{StaticResource PanelOutlineBrush}"
                                BorderThickness="1">
                            <!-- The track corner less the 3px inset, so the knob sits concentric. -->
                            <Rectangle x:Name="Knob"
                                       Width="14"
                                       Height="14"
                                       RadiusX="3"
                                       RadiusY="3"
                                       HorizontalAlignment="Left"
                                       Margin="3,0,0,0"
                                       Fill="{StaticResource PanelTextMutedBrush}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Description" Property="Text" Value="">
                            <Setter TargetName="Description"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track"
                                    Property="Background"
                                    Value="{StaticResource PanelAccentBrush}" />
                            <Setter TargetName="Track"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentBrush}" />
                            <Setter TargetName="Knob"
                                    Property="HorizontalAlignment"
                                    Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob"
                                    Property="Fill"
                                    Value="{StaticResource PanelOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track"
                                    Property="BorderBrush"
                                    Value="{StaticResource PanelAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain tick box for use inside a form, where a switch would overstate. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource PanelOutlineSubtleBrush}" />
        <Setter Property="Margin" Value="0,14" />
    </Style>

    <!-- Tooltips must match the surface they float over. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource PanelSurfaceElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PanelTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================== -->
    <!-- Disclosure                                                           -->
    <!-- ==================================================================== -->
    <!--
        "Detalhes técnicos": the raw Win32 code, the pipe name, the path. It is
        what an engineer needs and what an operator should not have to read, so
        it is present and closed rather than absent or shouted.
    -->
    <Style x:Key="PanelDisclosure" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource PanelTextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="Toggle"
                                      IsChecked="{Binding IsExpanded,
                                                          RelativeSource={RelativeSource TemplatedParent},
                                                          Mode=TwoWay}"
                                      Cursor="Hand"
                                      HorizontalAlignment="Left"
                                      Focusable="True">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Padding="6,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="Chevron"
                                                  Data="M0,0 L4,4 L0,8"
                                                  Stroke="{StaticResource PanelTextFaintBrush}"
                                                  StrokeThickness="1.4"
                                                  StrokeLineJoin="Round"
                                                  Width="6"
                                                  Height="9"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0"
                                                  RenderTransformOrigin="0.5,0.5" />
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root"
                                                    Property="Background"
                                                    Value="{StaticResource PanelSurfaceElevatedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Root"
                                                    Property="BorderBrush"
                                                    Value="{StaticResource PanelAccentBrush}" />
                                        </Trigger>
                                        <!-- Closed points right, open points down. -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron"
                                                    Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header" />
                        </ToggleButton>

                        <Border x:Name="Body"
                                Visibility="Collapsed"
                                Background="{StaticResource PanelSurfaceSunkenBrush}"
                                BorderBrush="{StaticResource PanelOutlineSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="11,9"
                                Margin="0,6,0,0">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
